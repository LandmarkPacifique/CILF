DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change_this_to_a_random_secret_string
APP_URL=https://www.landmark-pacifique.fr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.landmark-pacifique.fr/api/auth/google/callback

# Google Calendar (contact@landmark-pacifique.fr) : nécessite d'ajouter
# https://www.landmark-pacifique.fr/api/admin/google-calendar/callback
# comme URI de redirection autorisée sur le même client OAuth Google Cloud
# (et d'activer l'API "Google Calendar" sur ce projet).
GOOGLE_CALENDAR_REDIRECT_URI=https://www.landmark-pacifique.fr/api/admin/google-calendar/callback
GOOGLE_CALENDAR_SETUP_KEY=

# Envoi d'emails via l'API HTTP Brevo (remplace l'ancien MAKE_WEBHOOK_URL)
BREVO_API_KEY=votre_cle_api_brevo
SMTP_FROM="Landmark Pacifique <contact@landmark-pacifique.fr>"

# Secret partagé pour le webhook de statut de livraison Brevo.
# À configurer dans Brevo → Transactional → Settings → Webhooks sur :
# {APP_URL}/api/webhooks/brevo?key={BREVO_WEBHOOK_SECRET}
# Événements à cocher : delivered, hard_bounce, soft_bounce, blocked, invalid_email, spam, unsubscribed, opened
BREVO_WEBHOOK_SECRET=une_valeur_secrete_aleatoire
